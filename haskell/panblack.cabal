cabal-version:      3.0
name:               panblack
version:            0.99.0
synopsis:           Formatter for pandoc sources, guarded by pandoc itself
description:
  panblack formats documents with pandoc and only accepts the result if
  pandoc reads the formatted source the same way as the original.
  .
  pandoc is pinned to one exact version on purpose: formatter output
  depends on the pandoc version, so each panblack release bundles one.
homepage:           https://github.com/ickc/panblack
license:            GPL-2.0-or-later
license-file:       COPYING.md
copyright:          (c) 2021-2026 Kolen Cheung
author:             Kolen Cheung
maintainer:         christian.kolen@gmail.com
category:           Text
build-type:         Simple
tested-with:        GHC ==9.12.2
extra-doc-files:    COPYRIGHT

common warnings
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

common deps
  default-language: GHC2021
  default-extensions: DerivingStrategies LambdaCase MultiWayIf OverloadedStrings
  build-depends:
    , base          >=4.18 && <5
    , pandoc        ==3.10.2
    , pandoc-types  >=1.23.1.2 && <1.24
    , doctemplates  >=0.11 && <0.12
    , mtl           >=2.2 && <2.4
    , text          >=2.0 && <2.2

library
  import:           warnings, deps
  hs-source-dirs:   src
  build-depends:
    , aeson         >=2.0 && <2.4
    , bytestring    >=0.11 && <0.13
    , containers    >=0.6 && <0.8
    , crypton       >=0.30 && <1.2
    , Diff          >=1.0 && <2.1
    , directory     >=1.3 && <1.4
    , filepath      >=1.4 && <1.6
    , Glob          >=0.10 && <0.11
    , process       >=1.6 && <1.7
    , yaml          >=0.11 && <0.12
  exposed-modules:
    Panblack.Cache
    Panblack.Config
    Panblack.Diff
    Panblack.Discover
    Panblack.Guard
    Panblack.Jupytext
    Panblack.Markdown
    Panblack.Normalize
    Panblack.Notebook
    Panblack.Target.Html
    Panblack.Target.Registry

executable panblack
  import:           warnings, deps
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:    Paths_panblack
  autogen-modules:  Paths_panblack
  build-depends:
    , panblack
    , aeson
    , bytestring
    , containers
    , directory
    , filepath
    , process       >=1.6 && <1.7
  ghc-options:      -threaded -rtsopts

test-suite spec
  import:           warnings, deps
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:
    , panblack
    , aeson
    , bytestring
    , directory
    , filepath

-- Editor-build spike (plan step 1). Build with cabal.project.wasm.
executable panblack-wasm-md
  import:           warnings, deps
  hs-source-dirs:   wasm
  main-is:          Main.hs
  build-depends:    panblack

executable panblack-wasm-html
  import:           warnings, deps
  hs-source-dirs:   wasm
  main-is:          Main.hs
  build-depends:    panblack
  cpp-options:      -DWITH_HTML
