# The toolchains CI builds with; the Hackage snapshot is index-state in
# cabal.project. CI exports these.
# Native GHC, as tested-with in haskell/panblack.cabal.
GHC_VERSION=9.12.2
CABAL_VERSION=3.16.1.0
# quay.io/benz0li/ghc-musl:9.12.2, pinned by digest
GHC_MUSL_IMAGE=quay.io/benz0li/ghc-musl@sha256:024453a75c9e40c61252b5d54ffdb121a1cbb7678b39fe726cf3450ab357c3df
# GHC wasm toolchain (ghc-wasm-meta) and its GHC flavour: GHC 9.12.4.20260731
GHC_WASM_META_REV=ded427a58615ce21597f945af25c778f9107e5f7
GHC_WASM_FLAVOUR=9.12
