-- The wasm builds: the CLI and panblack-lite. Build with:
--   wasm32-wasi-cabal --project-file=cabal.project.wasm --builddir=dist-wasm build exe:panblack exe:panblack-lite
--
-- Mirrors the `if arch(wasm32)` block of pandoc 3.10.2's cabal.project,
-- minus what only pandoc-cli and the Lua engine need. The patches in
-- haskell/wasm/patches are copied from pandoc's wasm/patches (MIT, Tweag).
import: cabal.project

tests: False

-- Needed for the linker to drop unused formats. A top-level setting only
-- applies to local packages, so set it for every package.
package *
  split-sections: True

package atomic-counter
  flags: +no-cmm

package aeson
  flags: -ordered-keymap

package crypton
  ghc-options: -optc-DARGON2_NO_THREADS

package digest
  flags: -pkg-config

package pandoc
  flags: +embed_data_files -http

allow-newer:
  all:base,
  all:binary,
  all:bytestring,
  all:containers,
  all:ghc-bignum,
  all:template-haskell,
  all:text,
  all:time

-- post-checkout commands run in dist-wasm/src/<package>.
source-repository-package
  type: git
  location: https://github.com/snoyberg/conduit.git
  tag: 6b98f070fea09a3bf0a5d0897a2e27e3aa91c8fe
  subdir: conduit-extra
  post-checkout-command: sh -c "patch -N -p1 < ../../../haskell/wasm/patches/conduit-extra.patch"

source-repository-package
  type: git
  location: https://github.com/jappeace/ram.git
  tag: 6e49475ae7b4b3545923407388690234d838dc45
  post-checkout-command: sh -c "patch -N -p1 < ../../../haskell/wasm/patches/memory.patch"

source-repository-package
  type: git
  location: https://github.com/fpco/streaming-commons.git
  tag: v0.2.3.1
  post-checkout-command: sh -c "patch -N -p1 < ../../../haskell/wasm/patches/streaming-commons.patch"

source-repository-package
  type: git
  location: https://github.com/snoyberg/xml.git
  tag: xml-conduit/1.10.1.0
  subdir: xml-conduit
  post-checkout-command: sh -c "patch -N -p1 < ../../../haskell/wasm/patches/xml-conduit.patch"

source-repository-package
  type: git
  location: https://github.com/haskellari/splitmix.git
  tag: v0.1.3.2
  post-checkout-command: sh -c "patch -N -p1 < ../../../haskell/wasm/patches/splitmix.patch"
